{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "outDir": "dist",
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "tests",
    "tools/*.ts",
    "spikes",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.acceptance.config.ts"
  ]
}
