{
  "name": "rail-frontier",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "spike": "tsx spikes/core.ts",
    "validate:assets": "tsx tools/validate-assets.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx tools/copy-notices.ts",
    "preview": "vite preview",
    "screenshots:readme": "tsx tools/capture-readme-screenshots.ts",
    "test:browser": "playwright test",
    "spike:network": "tsx spikes/network-scale.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/three": "0.186.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/libre-caslon-display": "5.3.0",
    "three": "0.186.0",
    "zod": "4.6.4"
  }
}
